{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/descargas/quote-assistant-promocion-y-guia.mp4",
      "headers": [{ "key": "Content-Disposition", "value": "attachment; filename=\"quote-assistant-promocion-y-guia.mp4\"" }]
    },
    {
      "source": "/descargas/quote-assistant-guia-presentacion.pdf",
      "headers": [{ "key": "Content-Disposition", "value": "attachment; filename=\"quote-assistant-guia-presentacion.pdf\"" }]
    },
    {
      "source": "/descargas/quote-assistant-guia-presentacion.md",
      "headers": [{ "key": "Content-Disposition", "value": "attachment; filename=\"quote-assistant-guia-presentacion.md\"" }]
    },
    {
      "source": "/descargas/quote-assistant-informe-demo.pdf",
      "headers": [{ "key": "Content-Disposition", "value": "attachment; filename=\"quote-assistant-informe-demo.pdf\"" }]
    },
    {
      "source": "/descargas/quote-assistant-subtitulos.srt",
      "headers": [{ "key": "Content-Disposition", "value": "attachment; filename=\"quote-assistant-subtitulos.srt\"" }]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
